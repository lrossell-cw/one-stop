# Copy this file to .env and fill in your real values. Never commit .env itself.

# Your Jira Cloud site, no trailing slash
JIRA_BASE_URL=https://your-domain.atlassian.net

# The email address tied to your Atlassian account
JIRA_EMAIL=you@example.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=paste-your-token-here

PORT=3001

# --- Field names / IDs ---
# LOCATION_FIELD_NAME must be the exact DISPLAY NAME of the field, not a
# customfield_ id — "Asset Rack Location" is confirmed to be a Labels-type
# field, and Labels fields are queried by name (e.g. "Asset Rack
# Location[Labels]" = "..."), not by cf[] id reference like scalar
# custom fields. Leave this as the default unless your instance uses a
# different display name.
LOCATION_FIELD_NAME=Asset Rack Location

# SERIAL_FIELD_NAME / ASSET_TAG_FIELD_NAME are only used to read values
# back out of the ticket response (not to build the search query), so
# either the exact display name OR a raw field id/reference works here:
# "Serial Number", "customfield_10193", "cf[10193]", or bare "10193"
# are all accepted.
SERIAL_FIELD_NAME=cf[10193]
ASSET_TAG_FIELD_NAME=cf[10192]
